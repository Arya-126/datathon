# Copy to backend/.env and fill in what you have. Everything is optional —
# missing values degrade gracefully to local fallbacks.

# ---- LLM (rotating chain: QuickML → hosted providers → keyword fallback) ----
# Provide ANY subset of the keys below. Providers are tried in this order;
# a key that returns 429 (quota) goes on cooldown and the next one takes
# over automatically, so stacking keys = seamless quota failover.
# In production wrap credentials as Catalyst Connections and surface them
# to the AppSail as env vars with these same names.

# 1) Google Gemini — https://aistudio.google.com/app/apikey
#    GEMINI_API_KEY is the primary; GEMINI_API_KEYS is an optional
#    comma-separated pool of SPARE keys tried after it (gemini#2, #3, …).
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.0-flash

# 2) Groq (fast + generous free tier) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3) OpenRouter (many free models) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# 4) OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 5) Anthropic — https://console.anthropic.com (raw HTTP, no SDK needed)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Per-request timeout (seconds) for every hosted provider.
LLM_TIMEOUT=30

# ---- Server TTS (Kannada audio — no browser/Windows kn-IN voice exists) ----
# Chain: Sarvam → Google Cloud TTS → OpenAI TTS. Any one key is enough.
# 1) Sarvam AI (RECOMMENDED — Indian-language specialist, free key, NO card):
#    dashboard.sarvam.ai → API Keys → create → SARVAM_API_KEY
SARVAM_API_KEY=
SARVAM_TTS_SPEAKER=anushka
SARVAM_TTS_MODEL=bulbul:v2
# 2) Google Cloud TTS: real kn-IN voices, free 1M chars/month, but the
#    project needs an ACTIVE billing account (AI Studio Gemini key won't work).
GOOGLE_TTS_API_KEY=
# 3) OpenAI TTS (multilingual) — reuses OPENAI_API_KEY, needs paid quota.

# Optional shared demo password for /login (blank = open demo login).
KSP_DEMO_PASSWORD=

# Catalyst QuickML LLM-serving endpoint key (deployed endpoint → key).
# Only used when the request carries a Catalyst context (deployed AppSail).
CATALYST_QUICKML_ENDPOINT_KEY=

# ---- Catalyst SDK, local-dev credentials (NOT needed on AppSail) ----
# On the deployed AppSail the SDK initializes from request headers with zero
# config. Locally, to talk to the real project, create a Zoho self-client
# (api-console.zoho.in) with Catalyst scopes and fill these:
CATALYST_PROJECT_ID=
CATALYST_PROJECT_KEY=
CATALYST_PROJECT_DOMAIN=
CATALYST_ENVIRONMENT=Development
# JSON string: {"client_id":"..","client_secret":"..","refresh_token":".."}
CATALYST_AUTH=

# ---- Jobs / alerts ----
# Shared secret for POST /jobs/refresh (Catalyst Cron sends X-Cron-Key).
CRON_SECRET=
# Comma-separated Catalyst user emails to push spike alerts to (global default).
CATALYST_ALERT_RECIPIENTS=
# Jurisdiction routing: spikes in a district push to ITS recipients instead
# of the global list. Format: District=email,email;District2=email
# e.g. CATALYST_ALERT_ROUTES=Ballari=dysp.ballari@ksp.gov.in;Mysuru=dysp.mysuru@ksp.gov.in
CATALYST_ALERT_ROUTES=

# ---- Stratus (exported-PDF archive bucket) ----
CATALYST_STRATUS_BUCKET=

# ---- Optional server-side speech (no GA Zia speech API; leave empty and
#      the UI uses on-device Web Speech for kn-IN / en-IN) ----
CATALYST_ZIA_STT_URL=
CATALYST_ZIA_TTS_URL=
CATALYST_ZIA_KEY=
